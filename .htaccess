   Options -Indexes
   RewriteEngine On

   # API and uploaded photos -> PHP backend ([END] stops further rewriting)
   RewriteRule ^api(/|$)    backend/public/index.php [END]
   RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [END]

   # Hide private folders and files
   RewriteRule ^(backend|database|frontend|src)(/|$) - [F]
   RewriteRule ^(server\.cjs|README\.md)$ - [F]

   # React single-page app: serve index.html for non-file URLs
   RewriteCond %{REQUEST_FILENAME} !-f
   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteRule ^ index.html [L]