# Copy this file to  .env  and edit the values.
# (.env is ignored by git - never commit real passwords)

APP_ENV=development            # development | production
APP_DEBUG=true                 # true shows error details in JSON (turn OFF in production)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=equitrack
DB_USER=root
DB_PASS=                       # XAMPP default root password is empty

# Comma-separated list of front-end origins allowed to call the API (CORS).
# With the Vite proxy (npm run dev) requests are same-origin, so this is only
# needed if you call the API directly from another origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only these e-mail domains may self-register. Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAINS=

# Upload limits
MAX_UPLOAD_MB=2
