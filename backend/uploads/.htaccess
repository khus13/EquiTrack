# Uploaded files must NEVER be opened or executed directly.
# Photos are delivered through  GET /api/report-images/{id}  after a permission check.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
php_flag engine off
